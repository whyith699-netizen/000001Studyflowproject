rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read: if request.auth != null; // Allow searching for other users (e.g. by email)
      allow write: if request.auth != null && request.auth.uid == userId;

      // All subcollections under user (tasks, classes, studySessions, exams, settings, chatSessions, achievements, friends, inbox)
      match /{subcollection}/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Special rule for Inbox: allow other authenticated users to write (send message)
      match /inbox/{messageId} {
        allow create: if request.auth != null;
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Special rule for Friends: allow other authenticated users to see basic info if needed
      // (Current service model uses denormalization, so this is mostly for future-proofing)
    }

    // Global Badges collection - anyone authenticated can read
    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin via console/CLI
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
