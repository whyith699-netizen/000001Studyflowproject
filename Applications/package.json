{
  "name": "study-flow-app",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:gh-pages": "vite build --mode ghpages && node scripts/prepare-gh-pages.mjs",
    "deploy:gh-pages": "npm run build:gh-pages && gh-pages -d dist -b gh-pages -o origin -f --nojekyll -m \"deploy gh-pages\"",
    "predeploy": "npm run build:gh-pages",
    "deploy": "gh-pages -d dist -b gh-pages -o origin -f --nojekyll -m \"deploy gh-pages\"",
    "build:mobile": "set \"CAPACITOR_BUILD=true\" && set \"VITE_ENABLE_NOTES_ON_NATIVE=false\" && vite build",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:sync:android": "npm run build:mobile && npx cap sync android",
    "cap:sync:ios": "npm run build:mobile && npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "electron:dev": "set ELECTRON_BUILD=true && vite build && electron .",
    "electron:build:win": "set ELECTRON_BUILD=true && vite build && electron-builder --win",
    "electron:build:mac": "set ELECTRON_BUILD=true && vite build && electron-builder --mac"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/local-notifications": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "date-fns": "^4.1.0",
    "firebase": "^12.8.0",
    "lucide-react": "^0.574.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-store": "^10.0.0"
  }
}
